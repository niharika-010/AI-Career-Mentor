PROJECT_NAME="AI Career Assistant Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO

SECRET_KEY=super_secret_jwt_key_please_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite+aiosqlite:///./career.db
# For PostgreSQL in dev/prod:
# DATABASE_URL=postgresql+asyncpg://career_user:career_password@localhost:5432/career_db

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

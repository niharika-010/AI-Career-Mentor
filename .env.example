# Environment Configuration Example
PROJECT_NAME="AI Career Assistant Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
SECRET_KEY=change_this_to_a_secure_random_secret_key_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=career_user
POSTGRES_PASSWORD=career_password
POSTGRES_DB=career_db
DATABASE_URL=postgresql+asyncpg://career_user:career_password@localhost:5432/career_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
